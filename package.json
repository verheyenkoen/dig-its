{
  "name": "dig-its",
  "description": "A game with digits",
  "version": "1.0.0",
  "license": "MIT",
  "repository": "github:dig-its/dig-its",
  "scripts": {
    "version": "echo \"export default '`git rev-parse HEAD`';\" > version.js",
    "dev": "yarn run version && next",
    "build": "yarn run version && next build",
    "export": "yarn run build && next export",
    "lint": "next lint",
    "start": "next start",
    "serve": "yarn run export && npx http-server out/"
  },
  "dependencies": {
    "lodash": "^4.17.21",
    "next": "^16.0.10",
    "object-path": "0.11.8",
    "prop-types": "^15.8.1",
    "raven-js": "^3.27.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-fontawesome": "^1.7.1",
    "react-ga4": "^2.1.0",
    "reactstrap": "^9.2.3"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "eslint-config-next": "16.0.10"
  },
  "resolutions": {
    "nth-check": "^2.0.1"
  }
}
